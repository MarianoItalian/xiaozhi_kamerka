{
  "type": "diymore-esp32s3cam-vision",
  "target": "esp32s3",
  "builds": [
    {
      "name": "diymore-esp32s3cam-vision",
      "build_options": {
        "camera_hmirror": false,
        "camera_vflip": false
      },
      "sdkconfig_append": [
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\""
      ]
    }
  ]
}
